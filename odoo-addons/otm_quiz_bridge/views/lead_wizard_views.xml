<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_quiz_lead_wizard_form" model="ir.ui.view">
        <field name="name">otm.quiz.lead.wizard.form</field>
        <field name="model">otm.quiz.lead.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1"/>
                <group invisible="state == 'done'">
                    <field name="quiz_id" options="{'no_create': True}"/>
                    <field name="scope"/>
                    <field name="registration_ids" widget="many2many_tags" invisible="scope != 'selected'"/>
                    <field name="only_attempted"/>
                    <field name="leads_source" options="{'no_create': True}"/>
                    <field name="source_campaign_id" options="{'no_create': True}"/>
                    <field name="lead_owner" options="{'no_create': True}"/>
                    <field name="course_interested"/>
                </group>
                <div class="text-muted" invisible="state == 'done'">
                    Existing leads with the same phone number are linked instead of duplicated. A registration is
                    converted only once.
                </div>
                <group invisible="state != 'done'">
                    <field name="result" nolabel="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_convert" type="object" string="Convert to Leads" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_convert_registrations_to_leads" model="ir.actions.act_window">
        <field name="name">Convert to Leads</field>
        <field name="res_model">otm.quiz.lead.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="otm_quiz_management.model_otm_quiz_registration"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('otm_quiz_management.group_otm_quiz_manager'))]"/>
    </record>

    <record id="action_quiz_convert_all_to_leads" model="ir.actions.act_window">
        <field name="name">Convert Registrations to Leads</field>
        <field name="res_model">otm.quiz.lead.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
