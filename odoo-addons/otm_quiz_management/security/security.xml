<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_otm_quiz" model="res.groups.privilege">
        <field name="name">Quiz Management</field>
        <field name="category_id" ref="base.module_category_customizations"/>
    </record>

    <record id="group_otm_quiz_evaluator" model="res.groups">
        <field name="name">Evaluator</field>
        <field name="privilege_id" ref="privilege_otm_quiz"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_otm_quiz_manager" model="res.groups">
        <field name="name">Quiz Manager</field>
        <field name="privilege_id" ref="privilege_otm_quiz"/>
        <field name="implied_ids" eval="[(4, ref('group_otm_quiz_evaluator'))]"/>
    </record>

    <record id="group_otm_quiz_admin" model="res.groups">
        <field name="name">Quiz Administrator</field>
        <field name="privilege_id" ref="privilege_otm_quiz"/>
        <field name="implied_ids" eval="[(4, ref('group_otm_quiz_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_otm_quiz_api" model="res.groups">
        <field name="name">Quiz API Service (Next.js)</field>
        <field name="privilege_id" ref="privilege_otm_quiz"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
