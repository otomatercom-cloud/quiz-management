<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Registrations -->
    <record id="view_otm_quiz_registration_list" model="ir.ui.view">
        <field name="name">otm.quiz.registration.list</field>
        <field name="model">otm.quiz.registration</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancelled', 'disqualified')">
                <field name="reference"/>
                <field name="quiz_id"/>
                <field name="student_id"/>
                <field name="registration_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_otm_quiz_registration_form" model="ir.ui.view">
        <field name="name">otm.quiz.registration.form</field>
        <field name="model">otm.quiz.registration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'registered'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('registered', 'confirmed')"/>
                    <button name="action_disqualify" type="object" string="Disqualify"
                            invisible="state not in ('registered', 'confirmed')" confirm="Disqualify this student?"/>
                    <field name="state" widget="statusbar" statusbar_visible="registered,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="quiz_id"/>
                            <field name="student_id"/>
                        </group>
                        <group>
                            <field name="registration_date"/>
                            <field name="eligibility_status"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_otm_quiz_registration_search" model="ir.ui.view">
        <field name="name">otm.quiz.registration.search</field>
        <field name="model">otm.quiz.registration</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="student_id"/>
                <field name="quiz_id"/>
                <filter name="f_active" string="Active" domain="[('state', 'in', ('registered', 'confirmed'))]"/>
                <filter name="f_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <group>
                    <filter name="g_quiz" string="Quiz" context="{'group_by': 'quiz_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otm_quiz_registration" model="ir.actions.act_window">
        <field name="name">Registrations</field>
        <field name="res_model">otm.quiz.registration</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Attempts / results -->
    <record id="view_otm_quiz_attempt_list" model="ir.ui.view">
        <field name="name">otm.quiz.attempt.list</field>
        <field name="model">otm.quiz.attempt</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-success="result_status == 'pass'" decoration-danger="result_status == 'fail'">
                <field name="reference"/>
                <field name="student_id"/>
                <field name="quiz_id"/>
                <field name="attempt_number"/>
                <field name="submitted_at"/>
                <field name="marks_obtained"/>
                <field name="total_marks"/>
                <field name="percentage"/>
                <field name="result_status" widget="badge"/>
                <field name="scholarship_status" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_otm_quiz_attempt_form" model="ir.ui.view">
        <field name="name">otm.quiz.attempt.form</field>
        <field name="model">otm.quiz.attempt</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_print_result" type="object" string="Print Result"/>
                    <field name="state" widget="statusbar" statusbar_visible="in_progress,submitted,evaluated"/>
                </header>
                <sheet>
                    <group>
                        <group string="Attempt">
                            <field name="reference"/>
                            <field name="quiz_id"/>
                            <field name="student_id"/>
                            <field name="attempt_number"/>
                            <field name="started_at"/>
                            <field name="deadline_at"/>
                            <field name="submitted_at"/>
                            <field name="late_submission"/>
                            <field name="time_taken_seconds"/>
                        </group>
                        <group string="Result">
                            <field name="marks_obtained"/>
                            <field name="total_marks"/>
                            <field name="percentage"/>
                            <field name="passing_percentage_snapshot"/>
                            <field name="result_status"/>
                        </group>
                        <group string="Scholarship">
                            <field name="scholarship_status"/>
                            <field name="scholarship_rule_id"/>
                            <field name="scholarship_type"/>
                            <field name="scholarship_value"/>
                            <field name="scholarship_amount"/>
                            <field name="scholarship_overridden"/>
                            <field name="scholarship_explanation"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Answers" name="page_answers">
                            <field name="answer_ids">
                                <list>
                                    <field name="sequence"/>
                                    <field name="question_text"/>
                                    <field name="question_type"/>
                                    <field name="marks_available"/>
                                    <field name="marks_awarded"/>
                                    <field name="is_correct"/>
                                    <field name="review_status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_otm_quiz_attempt_search" model="ir.ui.view">
        <field name="name">otm.quiz.attempt.search</field>
        <field name="model">otm.quiz.attempt</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="student_id"/>
                <field name="quiz_id"/>
                <filter name="f_pass" string="Passed" domain="[('result_status', '=', 'pass')]"/>
                <filter name="f_fail" string="Failed" domain="[('result_status', '=', 'fail')]"/>
                <filter name="f_pending" string="Pending Review" domain="[('result_status', '=', 'pending')]"/>
                <filter name="f_sch" string="Scholarship eligible" domain="[('scholarship_status', 'in', ('eligible', 'approved'))]"/>
                <separator/>
                <group>
                    <filter name="g_quiz" string="Quiz" context="{'group_by': 'quiz_id'}"/>
                    <filter name="g_result" string="Result" context="{'group_by': 'result_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otm_quiz_attempt" model="ir.actions.act_window">
        <field name="name">Attempts &amp; Results</field>
        <field name="res_model">otm.quiz.attempt</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Audit -->
    <record id="view_otm_quiz_audit_list" model="ir.ui.view">
        <field name="name">otm.quiz.audit.log.list</field>
        <field name="model">otm.quiz.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="event"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="user_id"/>
                <field name="details"/>
            </list>
        </field>
    </record>

    <record id="action_otm_quiz_audit" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">otm.quiz.audit.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
