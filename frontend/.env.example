# Server-only variables (never prefix with NEXT_PUBLIC_)
ODOO_BASE_URL=https://odoo.example.com
ODOO_DATABASE=odoo19
# Odoo user in group "Quiz API Service (Next.js)" and its API key (Preferences > Account Security > New API Key)
ODOO_USERNAME=quiz_api
ODOO_API_KEY=replace-me
# 32+ random characters used to sign session cookies:  openssl rand -base64 48
SESSION_SECRET=replace-with-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3007

# Port: set PORT in the shell/systemd/pm2 environment (not read from this file). Default 3007.
