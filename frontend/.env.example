# Odoo 19 JSON-2 connection (server side only, never exposed to the browser)
ODOO_BASE_URL=https://your-odoo-host
ODOO_DATABASE=your_db
ODOO_USERNAME=quiz_api
ODOO_API_KEY=
# 64+ random characters, e.g. openssl rand -hex 32
SESSION_SECRET=
# Public URL of this app (baked at build time; rebuild after changing)
NEXT_PUBLIC_APP_URL=https://your-domain:3007
# PORT is read from the shell/pm2 environment (default 3007)
# Cloudflare Turnstile (optional; CAPTCHA is skipped when the secret is empty). Site key is public, baked at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
